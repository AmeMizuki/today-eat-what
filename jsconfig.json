{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ES2023",
    "module": "ESNext",
    "paths": { "$lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "vite.config.js"]
}
